# --- ProEx environment variables ---
# Copy this file to .env.local and fill in real values. .env.local is gitignored.

# Neon Postgres. Use the POOLED connection (host contains "-pooler") for DATABASE_URL,
# and the DIRECT (non-pooled) connection for DIRECT_URL (used by prisma migrate).
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Auth.js (NextAuth v5). Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me"

# Initial admin account created by `npm run db:seed`. Change the password after first login.
SEED_ADMIN_EMAIL="admin@proex.com"
SEED_ADMIN_PASSWORD="replace-me"

# UploadThing (file uploads). Create an app at https://uploadthing.com and paste the token.
UPLOADTHING_TOKEN=""

# Public site URL (canonical/SEO). Set to the production domain in prod.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
