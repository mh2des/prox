# Normalize line endings to LF in the repo, regardless of contributor OS.
# Prevents the whole-file CRLF/LF diff churn seen when files were edited on Windows.
* text=auto eol=lf

# Explicitly treat known text types as text (LF in repo).
*.js    text eol=lf
*.jsx   text eol=lf
*.mjs   text eol=lf
*.json  text eol=lf
*.css   text eol=lf
*.md    text eol=lf
*.html  text eol=lf

# Binary assets: never touch their bytes, never diff them.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.woff  binary
*.woff2 binary
*.pdf   binary
